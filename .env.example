# Optional environment variables for FloodResilience ASEAN.

# Copy to `.env` (git-ignored) to provide credentials. The pipeline works with
# public data alone; these keys only enable optional sources.

# --- NASA Earthdata (required only if you re-download GPM IMERG directly) ---
# Create a free account at https://urs.earthdata.nasa.gov/ and set these.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- SAC (SAP Analytics Cloud) credentials are managed by the team manually ---
# Do not commit SAC credentials. They are not used by any code in this repo.
